# Copier en .env puis remplir. Ne jamais versionner le .env.

# Adresse publique du site (sert aux redirections OAuth)
PUBLIC_URL=https://localhost:8443
HTTP_PORT=8080
HTTPS_PORT=8443

# Jeton partagé entre microservices pour les routes /internal (mettre une longue valeur aléatoire)
INTERNAL_TOKEN=change-me-to-a-long-random-string

# Connexion de développement sans OAuth (bouton « Connexion de test »). Laisser à false en production.
AUTH_DEV_LOGIN=false

# --- OAuth : un fournisseur sans identifiants est simplement désactivé ---
# Google : https://console.cloud.google.com/apis/credentials
#   URI de redirection : ${PUBLIC_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord : https://discord.com/developers/applications
#   URI de redirection : ${PUBLIC_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Apple : https://developer.apple.com (Services ID, clé « Sign in with Apple »)
#   URI de redirection : ${PUBLIC_URL}/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contenu du fichier .p8, sur une ligne, les retours à la ligne remplacés par \n
APPLE_PRIVATE_KEY=
